# Server Configuration
PORT=5000
NODE_ENV=development
CORS_ORIGIN=http://localhost,http://localhost:5173

# Database Configuration (Docker Compose local service or MongoDB Atlas)
# For local Docker Compose: mongodb://mongo:27017/interview_ai
# For MongoDB Atlas: mongodb+srv://<username>:<password>@cluster.mongodb.net/interview_ai?retryWrites=true&w=majority
MONGO_URI=mongodb://mongo:27017/interview_ai

# Authentication Secrets
JWT_SECRET=your_jwt_secret_key_here
JWT_REFRESH_SECRET=your_jwt_refresh_secret_key_here

# AI Service Configuration
GEMINI_API_KEY=your_gemini_api_key_here
OPENROUTER_API_KEY=your_openrouter_api_key_here
OPENROUTER_MODEL=openrouter/free
AI_FALLBACK_ENABLED=true

# Payment Gateway (Razorpay)
RAZORPAY_KEY_ID=rzp_test_dummy
RAZORPAY_KEY_SECRET=dummy_secret

# Email Configuration (Optional)
SMTP_HOST=smtp.ethereal.email
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
FROM_NAME=InterviewAI
FROM_EMAIL=noreply@interview.ai
